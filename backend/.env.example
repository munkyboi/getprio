# Shared configuration now lives in the repo root .env file.
# Managed database TLS uses normal certificate verification. Configure either
# the provider CA text or its absolute file path when it is not system-trusted.
DATABASE_SSL=false
DATABASE_SSL_CA=
DATABASE_SSL_CA_FILE=

# Worktree-local portal wiring convenience only. This is ignored in production.
# DEVELOPER_SESSION_NO_EXPIRY=true
# DEVELOPER_SESSION_NO_EXPIRY_DAYS=3650

# Authenticated Developer Portal Sandbox install link. Create this from the
# Sandbox external TestFlight group's Public Link settings in App Store Connect.
# SANDBOX_TESTFLIGHT_PUBLIC_URL=https://testflight.apple.com/join/...

# Google Play closed/internal test opt-in URL for the Sandbox Android app.
# SANDBOX_ANDROID_GOOGLE_PLAY_PUBLIC_URL=https://play.google.com/apps/testing/com.getprio.getprioMobile.android.sandbox
## Private vendor shadow sampling: disabled until explicit operator activation.
## Restart the API after configuration/artifact changes. No public rollout.
WAIT_TIME_SHADOW_ENABLED=false
WAIT_TIME_SHADOW_NAMESPACE=
WAIT_TIME_SHADOW_DATABASE_HOST=
WAIT_TIME_SHADOW_DATABASE_NAME=
WAIT_TIME_SHADOW_SCOPES=
WAIT_TIME_SHADOW_ARTIFACT_PATH=
WAIT_TIME_SHADOW_ARTIFACT_SHA256=
WAIT_TIME_SHADOW_SAMPLING_PERCENT=10
WAIT_TIME_SHADOW_MAX_PER_MINUTE=6
WAIT_TIME_SHADOW_TIMEOUT_MS=100
