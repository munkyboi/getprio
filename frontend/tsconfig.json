{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "types": [
      "vite/client",
      "node"
    ],
    "noEmit": true,
    "paths": {
      "@shared": [
        "shared/types"
      ],
      "@shared/*": [
        "shared/*"
      ],
      "@vendor/*": [
        "frontend/src/vendor/*"
      ]
    }
  },
  "include": [
    "src",
    "vite.config.ts"
  ]
}
